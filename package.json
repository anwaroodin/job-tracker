{
  "name": "job-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy && npm run extension:publish",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply job-tracker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply job-tracker-db --remote",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "runner": "node --env-file-if-exists=.env scripts/claude-runner.mjs",
    "extension:zip": "node scripts/zip-extension.mjs",
    "extension:publish": "node scripts/zip-extension.mjs --publish"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@legendapp/state": "^2.1.15",
    "@pdfme/common": "^6.2.8",
    "@pdfme/generator": "^6.2.8",
    "@pdfme/pdf-lib": "^6.2.8",
    "@pdfme/schemas": "^6.2.8",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "better-auth": "^1.7.5",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fontkit": "^2.0.4",
    "isbot": "^5.1.36",
    "lucide-react": "^0.462.0",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "typst-wasm": "^1.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-webfont-dl": "^3.13.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.154.0"
  }
}
