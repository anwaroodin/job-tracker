{
  "name": "job-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply job-tracker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply job-tracker-db --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@legendapp/state": "^2.1.15",
    "@radix-ui/react-dialog": "^1.1.4",
