# Copy to .dev.vars (git-ignored) and fill in for local dev.
# Production values are set with `wrangler secret put <NAME>`.

SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Comma-separated allowlist while single-user (optional)
ALLOWED_EMAILS=you@example.com

# Optional: classify emails with Jev (https://typesafe.ai). Without it the regex classifier is used.
# Set EMAIL_CLASSIFIER=regex to turn Jev off while keeping the key.
TYPESAFE_API_KEY=
