# Copy to .dev.vars (git-ignored) and fill in for local dev.
# Production values are set with `wrangler secret put <NAME>`.

SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret


# Optional: classify emails with Jev (https://typesafe.ai). Without it the regex classifier is used.
# Set EMAIL_CLASSIFIER=regex to turn Jev off while keeping the key.
TYPESAFE_API_KEY=

# Optional: company logos looked up by name with Logo.dev (https://www.logo.dev). Use the publishable key.
LOGO_DEV_TOKEN=

# Optional: the SMTP checker (smtp-checker/README.md). Without it, emails built from a pattern show as "Likely".
SMTP_CHECKER_URL=
SMTP_CHECKER_SECRET=

# Optional: Generect (https://generect.com) finds an email when the SMTP checker can't verify one. About $0.02 per email found, free when nothing is found.
GENERECT_API_KEY=

# Optional: Brave Search API (https://brave.com/search/api) finds recruiters and hiring managers on LinkedIn by search. About $5 of free credit a month.
BRAVE_SEARCH_API_KEY=

# Optional: monthly spend limits for the APIs above, in US dollars. Calls stop once a month's spend reaches them. Defaults: $5 each.
BRAVE_MONTHLY_BUDGET_USD=5
GENERECT_MONTHLY_BUDGET_USD=5
