/**
 * job-tracker — Cloudflare Workers config
 *
 * Secrets (set with `wrangler secret put <NAME>`):
 *   SESSION_SECRET       — random 32+ byte string, signs session cookies
 *   GOOGLE_CLIENT_ID     — OAuth client id
 *   GOOGLE_CLIENT_SECRET — OAuth client secret
 *   GOOGLE_REDIRECT_URI  — e.g. https://job-tracker.<subdomain>.workers.dev/auth/callback
 *   TYPESAFE_API_KEY     — optional, classifies emails with Jev (regex when unset)
 *   LOGO_DEV_TOKEN       — optional, Logo.dev publishable key for company logos
 *
 * Vars:
 *   EMAIL_CLASSIFIER     — optional, set to "regex" to turn Jev off
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "job-tracker",
	"compatibility_date": "2026-09-16",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./build/client",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "job-tracker-db",
			"database_id": "replace_with_id",
			"migrations_dir": "./migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "replace_with_id"
		}
	],
	"r2_buckets": [
		{
			"binding": "CVS",
			"bucket_name": "job-tracker-cvs"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "GMAIL_SYNC_QUEUE",
				"queue": "gmail-sync"
			}
		],
		"consumers": [
			{
				"queue": "gmail-sync",
				"max_batch_size": 5,
				"max_retries": 3,
				"dead_letter_queue": "gmail-sync-dlq"
			}
		]
	},
	"triggers": {
		"crons": [
			"*/30 * * * *"
		]
	},
	"previews": {
		"vars": {
			"APP_URL": "replace_with_url"
		},
		"kv_namespaces": [
			{
				"binding": "SESSIONS",
				"id": "replace_with_id"
			}
		],
		"d1_databases": [
			{
				"binding": "DB",
				"database_id": "replace_with_id"
			}
		],
		"r2_buckets": [
			{
				"binding": "CVS",
				"bucket_name": "job-tracker-cvs"
			}
		],
		"queues": {
			"producers": [
				{
					"binding": "GMAIL_SYNC_QUEUE",
					"queue": "gmail-sync"
				}
			]
		}
	},
	"vars": {
		"APP_URL": "replace_with_url"
	}
}